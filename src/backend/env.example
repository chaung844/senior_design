# ── Secrets (required) ────────────────────────────────────────────
AWS_BEDROCK_API_KEY=your-aws-bedrock-api-key-here

# ── Server / App ──────────────────────────────────────────────────
# APP_NAME=senior-design-backend
# DEBUG=false
# HOST=0.0.0.0
# PORT=8000
# BASE_PATH=safe/

# ── AWS / Region ──────────────────────────────────────────────────
# AWS_REGION=us-east-1

# ── Model Configuration ──────────────────────────────────────────
# MODEL_ID=qwen.qwen3-vl-235b-a22b
# MAX_INPUT_TOKENS=25096
# MAX_OUTPUT_TOKENS=1024
# TEMPERATURE=0.0
# TOP_P=1.0

# ── Image / PDF Processing ───────────────────────────────────────
# MAX_IMAGE_INPUTS=5
# MAX_IMAGE_DIMENSION=2048
# JPEG_QUALITY=80
# PDF_DPI=150

# ── Prompt / Instruction Paths ───────────────────────────────────
# SYSTEM_INSTRUCTION_PATH=prompts/receipts_parsing_instructions.md

# ── Database Configuration ───────────────────────────────────────
# DATABASE_URL=path_to_db

# ── AWS SQS URL ───────────────────────────────────────
AWS_SQS_URL=your-aws-sqs-url
